# Production Environment Template
# Copy this file to .env.production and replace placeholder values with actual credentials

# Production environment configuration
VITE_NODE_ENV=production

# Disable debug features in production
VITE_ENABLE_DEBUG=false
VITE_ENABLE_TEST_ROUTES=false
VITE_ENABLE_CONSOLE_LOGS=false

# Build optimization
VITE_BUILD_TIME=${BUILD_TIME}

# Production Ikhokha Payment Gateway Configuration
# CRITICAL: Replace these placeholder values with actual production credentials from Ikhokha
VITE_IKHOKHA_API_URL=https://api.ikhokha.com
VITE_IKHOKHA_API_KEY=YOUR_PRODUCTION_API_KEY_HERE
VITE_IKHOKHA_API_SECRET=YOUR_PRODUCTION_API_SECRET_HERE
VITE_IKHOKHA_WEBHOOK_SECRET=YOUR_PRODUCTION_WEBHOOK_SECRET_HERE
VITE_IKHOKHA_TEST_MODE=false
VITE_IKHOKHA_TIMEOUT=45000
VITE_IKHOKHA_RETRY_ATTEMPTS=3
VITE_IKHOKHA_RETRY_DELAY=2000

# Production Security Settings
VITE_ENABLE_WEBHOOK_VALIDATION=true
VITE_REQUIRE_HTTPS=true
VITE_ENABLE_PAYMENT_LOGGING=true

# Example of what production credentials should look like:
# VITE_IKHOKHA_API_KEY=IKP_PROD_1234567890ABCDEF1234567890ABCDEF
# VITE_IKHOKHA_API_SECRET=IKPS_PROD_ABCDEF1234567890ABCDEF1234567890
# VITE_IKHOKHA_WEBHOOK_SECRET=webhook_prod_secure_secret_key_2024

# IMPORTANT NOTES:
# 1. Never commit actual production credentials to version control
# 2. Store credentials securely using your deployment platform's secret management
# 3. Ensure all credentials are obtained from Ikhokha's production environment
# 4. Test credentials in staging before production deployment
# 5. Rotate credentials regularly for security